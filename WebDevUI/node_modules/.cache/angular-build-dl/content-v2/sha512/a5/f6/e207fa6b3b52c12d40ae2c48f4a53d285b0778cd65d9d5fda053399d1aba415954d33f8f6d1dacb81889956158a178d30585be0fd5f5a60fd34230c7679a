\n\r\n    if (event) {\r\n        event.stopPropagation();\r\n    }\r\n\r\n    // Close if already open\r\n    if (this.dropdownOpen) {\r\n        this.dropdownOpen = false;\r\n        return;\r\n    }\r\n\r\n    // Open dropdown\r\n    this.dropdownOpen = true;\r\n\r\n    // Reset search and pagination\r\n    this.searchText = '';\r\n    this.pageNumber = 1;\r\n    this.finished = false;\r\n    this.empList = [];\r\n\r\n    // Load first page\r\n    this.loadLineManagers(true);\r\n}\r\n\r\n\r\n// ============================================================\r\n// SEARCH\r\n// ============================================================\r\n\r\nonSearch(text: string): void {\r\n\r\n    this.searchText = text;\r\n\r\n    this.pageNumber = 1;\r\n    this.finished = false;\r\n    this.empList = [];\r\n\r\n    this.loadLineManagers(true);\r\n}\r\n\r\n\r\n// ============================================================\r\n// LOAD EMPLOYEE LIST\r\n// ============================================================\r\n\r\nloadLineManagers(reset: boolean = false): void {\r\n\r\n    if (this.loading) {\r\n        return;\r\n    }\r\n\r\n    if (reset) {\r\n        this.pageNumber = 1;\r\n        this.finished = false;\r\n        this.empList = [];\r\n    }\r\n\r\n    if (this.finished) {\r\n        return;\r\n    }\r\n\r\n    this.loading = true;\r\n\r\n    const param = {\r\n        pageNumber: this.pageNumber,\r\n        pageSize: this.pageSizes,\r\n        searchVal: this.searchText,\r\n        LoggedUserId: this.userID\r\n    };\r\n\r\n    this._dataservice\r\n        .getWithMultipleModel_Sync(this._supplyUrl, param)\r\n\r\n        .then((response: any) => {\r\n\r\n            this.loading = false;\r\n\r\n            const data = JSON.parse(\r\n                response?.resdata?.listEmp || '[]'\r\n            );\r\n\r\n            console.log(\"url data is \",data)\r\n\r\n            // No more data\r\n            if (!data || data.length === 0) {\r\n                this.finished = true;\r\n                return;\r\n            }\r\n\r\n            data.forEach((item: any) => {\r\n\r\n                const exists = this.empList.some(\r\n                    x => x.id === item.oid\r\n                );\r\n\r\n                if (!exists) {\r\n\r\n                    this.empList.push({\r\n                        id: item.oid,\r\n                        text: item.name\r\n                    });\r\n\r\n                }\r\n\r\n            });\r\n\r\n        })\r\n\r\n        .catch((err: any) => {\r\n\r\n            console.error(\r\n                'loadLineManagers error',\r\n                err\r\n            );\r\n\r\n            this.loading = false;\r\n\r\n        });\r\n}\r\n\r\n\r\n// ============================================================\r\n// SELECT LINE MANAGER\r\n// ============================================================\r\n\r\nselectLineManager(\r\n    item: {\r\n        id: number | string;\r\n        text: string;\r\n    },\r\n    event?: MouseEvent\r\n): void {\r\n\r\n    if (event) {\r\n        event.stopPropagation();\r\n    }\r\n\r\n    // Save selected value\r\n    this.selectedLineManagerId = item.id;\r\n    this.selectedLineManagerText = item.text;\r\n\r\n    // Set FormControl value\r\n    this.recruitmentApprovalForm\r\n        .get('lineManager')\r\n        ?.setValue(item.id);\r\n\r\n    // Mark control as touched\r\n    this.recruitmentApprovalForm\r\n        .get('lineManager')\r\n        ?.markAsTouched();\r\n\r\n    // Close dropdown\r\n    this.dropdownOpen = false;\r\n}\r\n\r\n\r\n// ============================================================\r\n// CHECK SELECTED ITEM\r\n// ============================================================\r\n\r\nisLineManagerSelected(\r\n    item: {\r\n        id: number | string;\r\n    }\r\n): boolean {\r\n\r\n    return this.recruitmentApprovalForm\r\n        .get('lineManager')\r\n        ?.value === item.id;\r\n}\r\n\r\n\r\n// ====================================